<Page

    x:Class="MailBridge.App.Views.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind L('restore.title')}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind L('restore.intro')}"
                       TextWrapping="Wrap" Opacity="0.7" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Header="{x:Bind L('restore.path')}" Width="400" Text="{x:Bind ViewModel.BackupPath, Mode=TwoWay}" />
                <Button Content="{x:Bind L('common.browse')}" Click="BrowseButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>

            <ComboBox Header="{x:Bind L('restore.target')}" ItemsSource="{x:Bind Accounts}"
                      SelectedItem="{x:Bind ViewModel.TargetAccount, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName" />

            <TextBlock Text="{x:Bind L('restore.selTitle')}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="{x:Bind L('restore.selLoadContents')}" Command="{x:Bind ViewModel.LoadContentsCommand}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingContents, Mode=OneWay}"
                              Visibility="{x:Bind ToVisibility(ViewModel.IsLoadingContents), Mode=OneWay}"
                              Width="24" Height="24" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" />
            </StackPanel>

            <Grid MinHeight="200" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListView Grid.Column="0" ItemsSource="{x:Bind ViewModel.BackupFolders}"
                          SelectedItem="{x:Bind ViewModel.SelectedBackupFolder, Mode=TwoWay}"
                          SelectionMode="Single" MaxHeight="240">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox IsThreeState="True" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalMessages}" Opacity="0.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ListView Grid.Column="1" ItemsSource="{x:Bind ViewModel.SelectedBackupFolder.Messages, Mode=OneWay}"
                          SelectionMode="None" MaxHeight="240">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" Width="220" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding From}" Opacity="0.6" TextTrimming="CharacterEllipsis" Width="140" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DateText}" Opacity="0.6" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            <TextBlock Text="{x:Bind L('restore.selHint')}" Opacity="0.6" TextWrapping="Wrap" Margin="0,-8,0,0" />

            <TextBlock Text="{x:Bind L('restore.filters')}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <TextBox Header="{x:Bind L('restore.from')}" Text="{x:Bind ViewModel.FromContains, Mode=TwoWay}" />
            <TextBox Header="{x:Bind L('restore.subject')}" Text="{x:Bind ViewModel.SubjectContains, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CalendarDatePicker Header="{x:Bind L('restore.dateFrom')}" Date="{x:Bind ViewModel.DateFrom, Mode=TwoWay}" />
                <CalendarDatePicker Header="{x:Bind L('restore.dateTo')}" Date="{x:Bind ViewModel.DateTo, Mode=TwoWay}" />
            </StackPanel>

            <Button Content="{x:Bind L('restore.start')}" Command="{x:Bind ViewModel.RunRestoreCommand}" Style="{StaticResource AccentButtonStyle}" />

            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />

            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
