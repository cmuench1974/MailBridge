<Page
    x:Class="MailBridge.App.Views.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,4,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <FontIcon Glyph="&#xE895;" Style="{StaticResource PageHeaderIconStyle}" />
            <StackPanel VerticalAlignment="Center" MaxWidth="760">
                <TextBlock Text="{x:Bind L('restore.title')}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind L('restore.intro')}" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- Toolbar -->
        <CommandBar Grid.Row="1" Style="{StaticResource ToolbarStyle}">
            <AppBarButton Label="{x:Bind L('restore.start')}" Command="{x:Bind ViewModel.RunRestoreCommand}">
                <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">

                <!-- Backup and target -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="16" Spacing="12">
                        <TextBlock Text="{x:Bind L('restore.source')}" Style="{StaticResource CardTitleStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="{x:Bind L('restore.path')}" Text="{x:Bind ViewModel.BackupPath, Mode=TwoWay}" />
                            <Button Grid.Column="1" Content="{x:Bind L('common.browse')}" Click="BrowseButton_Click" VerticalAlignment="Bottom" />
                        </Grid>
                        <ComboBox Header="{x:Bind L('restore.target')}" ItemsSource="{x:Bind Accounts}"
                                  SelectedItem="{x:Bind ViewModel.TargetAccount, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" MinWidth="320" />
                    </StackPanel>
                </Border>

                <!-- Selection -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="16" Spacing="8">
                        <TextBlock Text="{x:Bind L('restore.selTitle')}" Style="{StaticResource CardTitleStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="{x:Bind L('restore.selChoose')}" Click="SelectContentsButton_Click" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingContents, Mode=OneWay}"
                                          Visibility="{x:Bind ToVisibility(ViewModel.IsLoadingContents), Mode=OneWay}"
                                          Width="24" Height="24" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind L('restore.selHint')}" Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Filters -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="16" Spacing="12">
                        <TextBlock Text="{x:Bind L('restore.filters')}" Style="{StaticResource CardTitleStyle}" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="{x:Bind L('restore.from')}" Text="{x:Bind ViewModel.FromContains, Mode=TwoWay}" />
                            <TextBox Grid.Column="1" Header="{x:Bind L('restore.subject')}" Text="{x:Bind ViewModel.SubjectContains, Mode=TwoWay}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CalendarDatePicker Header="{x:Bind L('restore.dateFrom')}" Date="{x:Bind ViewModel.DateFrom, Mode=TwoWay}" />
                            <CalendarDatePicker Header="{x:Bind L('restore.dateTo')}" Date="{x:Bind ViewModel.DateTo, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Progress and status -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="16" Spacing="12">
                        <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
