<Page

    x:Class="MailBridge.App.Views.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind L('restore.title')}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind L('restore.intro')}"
                       TextWrapping="Wrap" Opacity="0.7" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Header="{x:Bind L('restore.path')}" Width="400" Text="{x:Bind ViewModel.BackupPath, Mode=TwoWay}" />
                <Button Content="{x:Bind L('common.browse')}" Click="BrowseButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>

            <ComboBox Header="{x:Bind L('restore.target')}" ItemsSource="{x:Bind Accounts}"
                      SelectedItem="{x:Bind ViewModel.TargetAccount, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName" />

            <TextBlock Text="{x:Bind L('restore.filters')}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <TextBox Header="{x:Bind L('restore.from')}" Text="{x:Bind ViewModel.FromContains, Mode=TwoWay}" />
            <TextBox Header="{x:Bind L('restore.subject')}" Text="{x:Bind ViewModel.SubjectContains, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CalendarDatePicker Header="{x:Bind L('restore.dateFrom')}" Date="{x:Bind ViewModel.DateFrom, Mode=TwoWay}" />
                <CalendarDatePicker Header="{x:Bind L('restore.dateTo')}" Date="{x:Bind ViewModel.DateTo, Mode=TwoWay}" />
            </StackPanel>

            <Button Content="{x:Bind L('restore.start')}" Command="{x:Bind ViewModel.RunRestoreCommand}" Style="{StaticResource AccentButtonStyle}" />

            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />

            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
