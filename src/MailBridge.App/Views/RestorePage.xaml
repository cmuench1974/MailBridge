<Page
    x:Class="MailBridge.App.Views.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Restore" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Uploads messages from a backup into the target account. Existing messages that match on Message-ID and other attributes are detected and never duplicated blindly."
                       TextWrapping="Wrap" Opacity="0.7" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Header="Backup folder or .zip file" Width="400" Text="{x:Bind ViewModel.BackupPath, Mode=TwoWay}" />
                <Button Content="Browse..." Click="BrowseButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>

            <ComboBox Header="Target account" ItemsSource="{x:Bind Accounts}"
                      SelectedItem="{x:Bind ViewModel.TargetAccount, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName" />

            <TextBlock Text="Filters (optional)" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <TextBox Header="From contains" Text="{x:Bind ViewModel.FromContains, Mode=TwoWay}" />
            <TextBox Header="Subject contains" Text="{x:Bind ViewModel.SubjectContains, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CalendarDatePicker Header="From date" Date="{x:Bind ViewModel.DateFrom, Mode=TwoWay}" />
                <CalendarDatePicker Header="To date" Date="{x:Bind ViewModel.DateTo, Mode=TwoWay}" />
            </StackPanel>

            <Button Content="Start restore" Command="{x:Bind ViewModel.RunRestoreCommand}" Style="{StaticResource AccentButtonStyle}" />

            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />

            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
