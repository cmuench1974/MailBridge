<Page

    x:Class="MailBridge.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind L('settings.title')}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind L('settings.intro')}"
                       TextWrapping="Wrap" Opacity="0.7" />

            <ComboBox Header="{x:Bind L('settings.language')}" ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                      SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
            <TextBlock Text="{x:Bind L('settings.languageNote')}" Opacity="0.7" Margin="0,-8,0,0" />

            <ComboBox Header="{x:Bind L('settings.theme')}" ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                      SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Header="{x:Bind L('settings.defaultDir')}" Width="400"
                         Text="{x:Bind ViewModel.DefaultBackupDirectory, Mode=TwoWay}" />
                <Button Content="{x:Bind L('common.browse')}" Click="BrowseButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>

            <CheckBox Content="{x:Bind L('settings.defaultZip')}"
                      IsChecked="{x:Bind ViewModel.DefaultCompressToZip, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="{x:Bind L('settings.save')}" Command="{x:Bind ViewModel.SaveCommand}" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="{x:Bind L('settings.openData')}" Click="OpenDataFolderButton_Click" />
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
