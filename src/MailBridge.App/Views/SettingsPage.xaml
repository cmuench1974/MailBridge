<Page
    x:Class="MailBridge.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,4,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <FontIcon Glyph="&#xE713;" Style="{StaticResource PageHeaderIconStyle}" />
            <StackPanel VerticalAlignment="Center" MaxWidth="760">
                <TextBlock Text="{x:Bind L('settings.title')}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind L('settings.intro')}" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- Toolbar -->
        <CommandBar Grid.Row="1" Style="{StaticResource ToolbarStyle}">
            <AppBarButton Label="{x:Bind L('settings.save')}" Command="{x:Bind ViewModel.SaveCommand}">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="{x:Bind L('settings.openData')}" Click="OpenDataFolderButton_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE838;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                <TextBlock Text="{x:Bind L('settings.general')}" Style="{StaticResource SettingsSectionHeaderStyle}" Margin="2,4,0,6" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="16" Spacing="12">
                        <ComboBox Header="{x:Bind L('settings.language')}" ItemsSource="{x:Bind ViewModel.LanguageOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" MinWidth="240" />
                        <TextBlock Text="{x:Bind L('settings.languageNote')}" Style="{StaticResource HintTextStyle}" Margin="0,-6,0,0" />
                        <ComboBox Header="{x:Bind L('settings.theme')}" ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" MinWidth="240" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Bind L('settings.backupDefaults')}" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="16" Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="{x:Bind L('settings.defaultDir')}"
                                     Text="{x:Bind ViewModel.DefaultBackupDirectory, Mode=TwoWay}" />
                            <Button Grid.Column="1" Content="{x:Bind L('common.browse')}" Click="BrowseButton_Click" VerticalAlignment="Bottom" />
                        </Grid>
                        <CheckBox Content="{x:Bind L('settings.defaultZip')}"
                                  IsChecked="{x:Bind ViewModel.DefaultCompressToZip, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" Margin="2,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
