<ContentDialog
    x:Class="MailBridge.App.Views.ConflictDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Possible duplicate found"
    PrimaryButtonText="Replace"
    SecondaryButtonText="Skip"
    CloseButtonText="Abort restore"
    DefaultButton="Secondary">

    <StackPanel Spacing="12" MaxWidth="420">
        <TextBlock TextWrapping="Wrap"
                   Text="A message on the server shares identifying details with this backed-up message, but not everything matches - so it is not automatically treated as an identical duplicate." />

        <TextBlock Text="{x:Bind SubjectText}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind MatchedText}" TextWrapping="Wrap" Opacity="0.8" />
        <TextBlock Text="{x:Bind DifferingText}" TextWrapping="Wrap" Foreground="OrangeRed" />

        <CheckBox x:Name="ApplyToAllCheckBox" Content="Apply this choice to all remaining conflicts in this restore" />
    </StackPanel>
</ContentDialog>
