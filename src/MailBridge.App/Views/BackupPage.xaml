<Page

    x:Class="MailBridge.App.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{x:Bind L('backup.title')}" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="{x:Bind L('backup.intro')}"
                   TextWrapping="Wrap" Opacity="0.7" />

        <ComboBox Header="{x:Bind L('backup.sourceAccount')}" ItemsSource="{x:Bind Accounts}"
                  SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Header="{x:Bind L('backup.destination')}" Width="400" Text="{x:Bind ViewModel.DestinationDirectory, Mode=TwoWay}" />
            <Button Content="{x:Bind L('common.browse')}" Click="BrowseButton_Click" VerticalAlignment="Bottom" />
        </StackPanel>

        <CheckBox Content="{x:Bind L('common.compress')}" IsChecked="{x:Bind ViewModel.CompressToZip, Mode=TwoWay}" />

        <TextBlock Text="{x:Bind L('backup.selTitle')}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="{x:Bind L('backup.selLoadFolders')}" Command="{x:Bind ViewModel.LoadFoldersCommand}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingFolders, Mode=OneWay}"
                          Visibility="{x:Bind ToVisibility(ViewModel.IsLoadingFolders), Mode=OneWay}"
                          Width="24" Height="24" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>

        <Grid MinHeight="220" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" ItemsSource="{x:Bind ViewModel.ServerFolders}"
                      SelectedItem="{x:Bind ViewModel.SelectedServerFolder, Mode=TwoWay}"
                      SelectionMode="Single" MaxHeight="260">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox IsThreeState="True" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalMessages}" Opacity="0.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView Grid.Column="1" ItemsSource="{x:Bind ViewModel.SelectedServerFolder.Messages, Mode=OneWay}"
                      SelectionMode="None" MaxHeight="260">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" Width="220" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding From}" Opacity="0.6" TextTrimming="CharacterEllipsis" Width="140" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DateText}" Opacity="0.6" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <TextBlock Text="{x:Bind L('backup.selHint')}" Opacity="0.6" TextWrapping="Wrap" Margin="0,-8,0,0" />

        <Button Content="{x:Bind L('backup.start')}" Command="{x:Bind ViewModel.RunBackupCommand}"
                Style="{StaticResource AccentButtonStyle}" />

        <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />

        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
    </StackPanel>
</Page>
