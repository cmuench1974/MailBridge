<Page

    x:Class="MailBridge.App.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{x:Bind L('backup.title')}" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="{x:Bind L('backup.intro')}"
                   TextWrapping="Wrap" Opacity="0.7" />

        <ComboBox Header="{x:Bind L('backup.sourceAccount')}" ItemsSource="{x:Bind Accounts}"
                  SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Header="{x:Bind L('backup.destination')}" Width="400" Text="{x:Bind ViewModel.DestinationDirectory, Mode=TwoWay}" />
            <Button Content="{x:Bind L('common.browse')}" Click="BrowseButton_Click" VerticalAlignment="Bottom" />
        </StackPanel>

        <CheckBox Content="{x:Bind L('common.compress')}" IsChecked="{x:Bind ViewModel.CompressToZip, Mode=TwoWay}" />

        <TextBlock Text="{x:Bind L('backup.selTitle')}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="{x:Bind L('backup.selChoose')}" Click="SelectFoldersButton_Click" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingFolders, Mode=OneWay}"
                          Visibility="{x:Bind ToVisibility(ViewModel.IsLoadingFolders), Mode=OneWay}"
                          Width="24" Height="24" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{x:Bind L('backup.selHint')}" Opacity="0.6" TextWrapping="Wrap" Margin="0,-8,0,0" />

        <Button Content="{x:Bind L('backup.start')}" Command="{x:Bind ViewModel.RunBackupCommand}"
                Style="{StaticResource AccentButtonStyle}" />

        <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />

        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
    </StackPanel>
</Page>
