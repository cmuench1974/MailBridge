<Page
    x:Class="MailBridge.App.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Backup" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Text="Downloads every folder and message from the selected account."
                   TextWrapping="Wrap" Opacity="0.7" />

        <ComboBox Header="Source account" ItemsSource="{x:Bind Accounts}"
                  SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
                  DisplayMemberPath="DisplayName" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Header="Destination folder" Width="400" Text="{x:Bind ViewModel.DestinationDirectory, Mode=TwoWay}" />
            <Button Content="Browse..." Click="BrowseButton_Click" VerticalAlignment="Bottom" />
        </StackPanel>

        <CheckBox Content="Compress into a single .zip file" IsChecked="{x:Bind ViewModel.CompressToZip, Mode=TwoWay}" />

        <Button Content="Start backup" Command="{x:Bind ViewModel.RunBackupCommand}"
                Style="{StaticResource AccentButtonStyle}" />

        <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />

        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
    </StackPanel>
</Page>
