<Page
    x:Class="MailBridge.App.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,4,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <FontIcon Glyph="&#xE896;" Style="{StaticResource PageHeaderIconStyle}" />
            <StackPanel VerticalAlignment="Center" MaxWidth="760">
                <TextBlock Text="{x:Bind L('backup.title')}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind L('backup.intro')}" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- Toolbar -->
        <CommandBar Grid.Row="1" Style="{StaticResource ToolbarStyle}">
            <AppBarButton Label="{x:Bind L('backup.start')}" Command="{x:Bind ViewModel.RunBackupCommand}">
                <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">

                <!-- Source and destination -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="16" Spacing="12">
                        <TextBlock Text="{x:Bind L('backup.options')}" Style="{StaticResource CardTitleStyle}" />
                        <ComboBox Header="{x:Bind L('backup.sourceAccount')}" ItemsSource="{x:Bind Accounts}"
                                  SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" MinWidth="320" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="{x:Bind L('backup.destination')}" Text="{x:Bind ViewModel.DestinationDirectory, Mode=TwoWay}" />
                            <Button Grid.Column="1" Content="{x:Bind L('common.browse')}" Click="BrowseButton_Click" VerticalAlignment="Bottom" />
                        </Grid>
                        <CheckBox Content="{x:Bind L('common.compress')}" IsChecked="{x:Bind ViewModel.CompressToZip, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- Selection -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="16" Spacing="8">
                        <TextBlock Text="{x:Bind L('backup.selTitle')}" Style="{StaticResource CardTitleStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="{x:Bind L('backup.selChoose')}" Click="SelectFoldersButton_Click" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingFolders, Mode=OneWay}"
                                          Visibility="{x:Bind ToVisibility(ViewModel.IsLoadingFolders), Mode=OneWay}"
                                          Width="24" Height="24" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.SelectionSummary, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind L('backup.selHint')}" Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- Progress and status -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Padding="16" Spacing="12">
                        <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsRunning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
