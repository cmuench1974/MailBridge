<Window
    x:Class="MailBridge.App.Views.SelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="SummaryText" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <ProgressRing x:Name="LoadRing" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" x:Name="FolderList" SelectionMode="Single"
                      SelectionChanged="FolderList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox IsThreeState="True" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalMessages}" Opacity="0.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ListView Grid.Column="1" x:Name="MessageList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" Width="260" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding From}" Opacity="0.6" TextTrimming="CharacterEllipsis" Width="160" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DateText}" Opacity="0.6" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="ReloadButton" Click="ReloadButton_Click" HorizontalAlignment="Left" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CancelButton" Click="CancelButton_Click" />
                <Button x:Name="OkButton" Click="OkButton_Click" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
