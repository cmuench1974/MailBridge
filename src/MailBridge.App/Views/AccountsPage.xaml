<Page
    x:Class="MailBridge.App.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <x:String x:Key="EditLabel">Edit</x:String>
        <x:String x:Key="RemoveLabel">Remove</x:String>
    </Page.Resources>

    <Grid Padding="28" ColumnSpacing="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="16">
            <TextBlock Text="{x:Bind L('accounts.title')}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind L('accounts.intro')}"
                       TextWrapping="Wrap" Opacity="0.7" />

            <TextBox Header="{x:Bind L('accounts.displayName')}" Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}" />
            <TextBox Header="{x:Bind L('accounts.host')}" PlaceholderText="imap.example.com" Text="{x:Bind ViewModel.Host, Mode=TwoWay}" />
            <NumberBox Header="{x:Bind L('accounts.port')}" Value="{x:Bind ViewModel.Port, Mode=TwoWay}" />
            <TextBox Header="{x:Bind L('accounts.username')}" Text="{x:Bind ViewModel.Username, Mode=TwoWay}" />
            <PasswordBox Header="{x:Bind L('accounts.password')}" Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="{x:Bind ViewModel.FormTitle, Mode=OneWay}" Command="{x:Bind ViewModel.SaveAccountCommand}" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="{x:Bind L('accounts.testConnection')}" Command="{x:Bind ViewModel.TestConnectionCommand}" VerticalAlignment="Bottom" />
                <ProgressRing IsActive="{x:Bind ViewModel.TestConnectionCommand.IsRunning, Mode=OneWay}"
                              Visibility="{x:Bind ToVisibility(ViewModel.TestConnectionCommand.IsRunning), Mode=OneWay}"
                              Width="28" Height="28" VerticalAlignment="Center" />
                <Button Content="{x:Bind L('common.cancel')}" Command="{x:Bind ViewModel.CancelEditCommand}"
                        Visibility="{x:Bind ToVisibility(ViewModel.IsEditing), Mode=OneWay}" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind L('accounts.keepPasswordHint')}"
                       TextWrapping="Wrap" Opacity="0.7"
                       Visibility="{x:Bind ToVisibility(ViewModel.IsEditing), Mode=OneWay}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Text="{x:Bind L('accounts.saved')}" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Accounts}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Username}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Host}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="{StaticResource EditLabel}" Click="OnEditAccountClick" />
                                <Button Content="{StaticResource RemoveLabel}" Click="OnRemoveAccountClick" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
