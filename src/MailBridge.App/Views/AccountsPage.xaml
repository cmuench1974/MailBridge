<Page
    x:Class="MailBridge.App.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Accounts" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Add an IMAP account (username + app password). Gmail/Outlook require OAuth2 and are not yet supported."
                       TextWrapping="Wrap" Opacity="0.7" />

            <TextBox Header="Display name" Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}" />
            <TextBox Header="IMAP host" PlaceholderText="imap.example.com" Text="{x:Bind ViewModel.Host, Mode=TwoWay}" />
            <NumberBox Header="Port" Value="{x:Bind ViewModel.Port, Mode=TwoWay}" />
            <TextBox Header="Username" Text="{x:Bind ViewModel.Username, Mode=TwoWay}" />
            <PasswordBox Header="Password / app password" Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="{x:Bind ViewModel.FormTitle, Mode=OneWay}" Command="{x:Bind ViewModel.SaveAccountCommand}" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Cancel" Command="{x:Bind ViewModel.CancelEditCommand}"
                        Visibility="{x:Bind ToVisibility(ViewModel.IsEditing), Mode=OneWay}" />
            </StackPanel>
            <TextBlock Text="Leave the password empty to keep the stored password."
                       TextWrapping="Wrap" Opacity="0.7"
                       Visibility="{x:Bind ToVisibility(ViewModel.IsEditing), Mode=OneWay}" />

            <TextBlock Text="Saved accounts" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <ListView ItemsSource="{x:Bind ViewModel.Accounts}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Host}" Opacity="0.7" />
                            <TextBlock Text="{Binding Username}" Opacity="0.7" />
                            <Button Content="Edit" Click="OnEditAccountClick" />
                            <Button Content="Remove" Click="OnRemoveAccountClick" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
