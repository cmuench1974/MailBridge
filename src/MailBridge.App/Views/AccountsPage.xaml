<Page
    x:Class="MailBridge.App.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <x:String x:Key="EditLabel">Edit</x:String>
        <x:String x:Key="RemoveLabel">Remove</x:String>
    </Page.Resources>

    <Grid Padding="24,4,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <FontIcon Glyph="&#xE77B;" Style="{StaticResource PageHeaderIconStyle}" />
            <StackPanel VerticalAlignment="Center" MaxWidth="760">
                <TextBlock Text="{x:Bind L('accounts.title')}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind L('accounts.intro')}" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Account form -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                    <StackPanel Padding="16" Spacing="12">
                        <TextBlock Text="{x:Bind L('accounts.form')}" Style="{StaticResource CardTitleStyle}" />

                        <TextBox Header="{x:Bind L('accounts.displayName')}" Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}" />
                        <TextBox Header="{x:Bind L('accounts.host')}" PlaceholderText="imap.example.com" Text="{x:Bind ViewModel.Host, Mode=TwoWay}" />
                        <NumberBox Header="{x:Bind L('accounts.port')}" Value="{x:Bind ViewModel.Port, Mode=TwoWay}" />
                        <TextBox Header="{x:Bind L('accounts.username')}" Text="{x:Bind ViewModel.Username, Mode=TwoWay}" />
                        <PasswordBox Header="{x:Bind L('accounts.password')}" Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
                        <TextBlock Text="{x:Bind L('accounts.keepPasswordHint')}"
                                   Style="{StaticResource HintTextStyle}" Margin="0,-6,0,0"
                                   Visibility="{x:Bind ToVisibility(ViewModel.IsEditing), Mode=OneWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Content="{x:Bind ViewModel.FormTitle, Mode=OneWay}" Command="{x:Bind ViewModel.SaveAccountCommand}" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="{x:Bind L('accounts.testConnection')}" Command="{x:Bind ViewModel.TestConnectionCommand}" />
                            <Button Content="{x:Bind L('common.cancel')}" Command="{x:Bind ViewModel.CancelEditCommand}"
                                    Visibility="{x:Bind ToVisibility(ViewModel.IsEditing), Mode=OneWay}" />
                            <ProgressRing IsActive="{x:Bind ViewModel.TestConnectionCommand.IsRunning, Mode=OneWay}"
                                          Visibility="{x:Bind ToVisibility(ViewModel.TestConnectionCommand.IsRunning), Mode=OneWay}"
                                          Width="24" Height="24" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.ConnectionStatus, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Saved accounts -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="16,10,16,10"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="0,0,0,1">
                        <TextBlock Text="{x:Bind L('accounts.saved')}" Style="{StaticResource TableHeaderTextStyle}" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Accounts}" SelectionMode="None"
                              ItemContainerStyle="{StaticResource TableItemContainerStyle}"
                              Padding="0,4,0,4">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="4" Padding="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE715;" Style="{StaticResource TableCellIconStyle}" />
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Style="{StaticResource TableCellTextStyle}" />
                                        <TextBlock Text="{Binding Username}" Style="{StaticResource TableHeaderTextStyle}" />
                                        <TextBlock Text="{Binding Host}" Style="{StaticResource TableHeaderTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SubtleButtonStyle}" Click="OnEditAccountClick"
                                                ToolTipService.ToolTip="{StaticResource EditLabel}"
                                                AutomationProperties.Name="{StaticResource EditLabel}">
                                            <FontIcon Glyph="&#xE70F;" FontSize="16" />
                                        </Button>
                                        <Button Style="{StaticResource SubtleButtonStyle}" Click="OnRemoveAccountClick"
                                                ToolTipService.ToolTip="{StaticResource RemoveLabel}"
                                                AutomationProperties.Name="{StaticResource RemoveLabel}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
