<Page
    x:Class="MailBridge.App.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,4,24,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <FontIcon Glyph="&#xE823;" Style="{StaticResource PageHeaderIconStyle}" />
            <StackPanel VerticalAlignment="Center" MaxWidth="760">
                <TextBlock Text="{x:Bind L('schedule.title')}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind L('schedule.intro')}" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- New schedule -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
                    <StackPanel Padding="16" Spacing="12">
                        <TextBlock Text="{x:Bind L('schedule.new')}" Style="{StaticResource CardTitleStyle}" />

                        <ComboBox Header="{x:Bind L('schedule.account')}" ItemsSource="{x:Bind ViewModel.Accounts}"
                                  SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="{x:Bind L('schedule.destination')}" Text="{x:Bind ViewModel.DestinationDirectory, Mode=TwoWay}" />
                            <Button Grid.Column="1" Content="{x:Bind L('common.browse')}" Click="BrowseButton_Click" VerticalAlignment="Bottom" />
                        </Grid>

                        <CheckBox Content="{x:Bind L('common.compress')}" IsChecked="{x:Bind ViewModel.CompressToZip, Mode=TwoWay}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Header="{x:Bind L('schedule.frequency')}" ItemsSource="{x:Bind ViewModel.Frequencies}"
                                      SelectedItem="{x:Bind ViewModel.Frequency, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="1" Header="{x:Bind L('schedule.dayOfWeek')}" ItemsSource="{x:Bind ViewModel.DaysOfWeek}"
                                      SelectedItem="{x:Bind ViewModel.DayOfWeek, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        </Grid>
                        <TimePicker Header="{x:Bind L('schedule.time')}" Time="{x:Bind ViewModel.TimeOfDay, Mode=TwoWay}" />

                        <Button Content="{x:Bind L('schedule.add')}" Command="{x:Bind ViewModel.AddScheduleCommand}"
                                Style="{StaticResource AccentButtonStyle}" Margin="0,4,0,0" />

                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Existing schedules -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{x:Bind L('schedule.existing')}" Style="{StaticResource CardTitleStyle}" Margin="16,12,16,4" />

                    <!-- Table header -->
                    <Grid Grid.Row="1" Padding="16,6,16,8" ColumnSpacing="12"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                          BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind L('schedule.colAccount')}" Style="{StaticResource TableHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind L('schedule.colFrequency')}" Style="{StaticResource TableHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind L('schedule.colTime')}" Style="{StaticResource TableHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind L('schedule.colEnabled')}" Style="{StaticResource TableHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind L('schedule.colLastRun')}" Style="{StaticResource TableHeaderTextStyle}" />
                    </Grid>

                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Schedules}" SelectionMode="None"
                              ItemContainerStyle="{StaticResource TableItemContainerStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Margin="4,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding AccountDisplayName}" FontWeight="SemiBold" Style="{StaticResource TableCellTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Frequency}" Style="{StaticResource TableCellTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{Binding TimeOfDay}" Style="{StaticResource TableCellTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Enabled}" Style="{StaticResource TableCellTextStyle}" />
                                    <TextBlock Grid.Column="4" Text="{Binding LastRunMessage}" Style="{StaticResource TableCellTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
