<Page

    x:Class="MailBridge.App.Views.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" ColumnSpacing="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="16">
            <TextBlock Text="{x:Bind L('schedule.title')}" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="{x:Bind L('schedule.intro')}" />

            <ComboBox Header="{x:Bind L('schedule.account')}" ItemsSource="{x:Bind ViewModel.Accounts}"
                      SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Header="{x:Bind L('schedule.destination')}" Text="{x:Bind ViewModel.DestinationDirectory, Mode=TwoWay}" />
                <Button Content="{x:Bind L('common.browse')}" Click="BrowseButton_Click" VerticalAlignment="Bottom" />
            </StackPanel>

            <CheckBox Content="{x:Bind L('common.compress')}" IsChecked="{x:Bind ViewModel.CompressToZip, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Spacing="16">
                <ComboBox Header="{x:Bind L('schedule.frequency')}" ItemsSource="{x:Bind ViewModel.Frequencies}" SelectedItem="{x:Bind ViewModel.Frequency, Mode=TwoWay}" />
                <ComboBox Header="{x:Bind L('schedule.dayOfWeek')}" ItemsSource="{x:Bind ViewModel.DaysOfWeek}" SelectedItem="{x:Bind ViewModel.DayOfWeek, Mode=TwoWay}" />
                <TimePicker Header="{x:Bind L('schedule.time')}" Time="{x:Bind ViewModel.TimeOfDay, Mode=TwoWay}" />
            </StackPanel>

            <Button Content="{x:Bind L('schedule.add')}" Command="{x:Bind ViewModel.AddScheduleCommand}" Style="{StaticResource AccentButtonStyle}" />

            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Text="{x:Bind L('schedule.existing')}" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Schedules}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,4">
                            <TextBlock Text="{Binding AccountDisplayName}" FontWeight="SemiBold" Width="140" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Frequency}" Width="70" />
                            <TextBlock Text="{Binding TimeOfDay}" Width="90" />
                            <TextBlock Text="{Binding Enabled}" Width="60" />
                            <TextBlock Text="{Binding LastRunMessage}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
